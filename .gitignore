# macOS noise
.DS_Store

# cc65 leaves object files beside the sources
src/*.o

# The traced build's smaller song set, generated by tools/bedtrim.py from
# sources that ARE committed - unlike src/song.h, whose assets/midi is not
# published, so this one need not be carried.
src/song_dbg.h
src/song_dbg_ids.h
src/song_beds_dbg.h
tools/songs-midi-dbg.mml

# Build output is generated - except the two binaries the README offers as
# downloads, which are tracked on purpose so those links resolve, and the
# sidecar checksums that describe them, which are no use to a downloader
# unless they are published alongside them.
build/*
!build/urfinkel.d64
!build/urfinkel.prg
!build/*.sha256
!build/*.md5
!build/CHECKSUMS.txt
!build/urfinkel.zip
!build/urfinkel.tar.gz
