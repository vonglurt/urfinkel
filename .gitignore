# macOS noise
.DS_Store

# cc65 leaves object files beside the sources
src/*.o

# Build output is generated - except the two binaries the README offers as
# downloads, which are tracked on purpose so those links resolve, and the
# checksum file that describes them, which is no use to a downloader unless
# it is published alongside them.
build/*
!build/urfinkel.d64
!build/urfinkel.prg
!build/CHECKSUMS.txt
