#!/bin/sh
#
# Clean-rebuild the game before every commit, run the host tests, and stage
# the rebuilt binaries.
#
# WHY REBUILD RATHER THAN COMPARE.  The Makefile stamps the program with
# `date +%Y.%m.%d%H`, so the same sources built in two different hours are
# byte-different on purpose - the build date is drawn on the menu.  A hook
# that checked "does the committed .prg match a fresh build" would therefore
# fail every morning for a reason that is not a defect.  This one makes the
# committed binary current instead of asserting that it already was.
#
# WHAT IT GUARANTEES.  Every commit contains a .prg and .d64 that were built
# from the sources in that same commit, by a build that started from nothing,
# with the host test suite passing.  That matters here because those two
# binaries are what the README offers as downloads and what the play page
# loads: a stale one is a visitor's problem, not a developer's.
#
# Install:  git config core.hooksPath tools/hooks
# Bypass:   git commit --no-verify        (not needed for docs: a commit that
#           does not change the program keeps its version)

set -e

# Hooks do not inherit an interactive shell's PATH, so Homebrew is put back.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v cl65 >/dev/null 2>&1; then
    echo "pre-commit: cl65 not found - install cc65 (brew install cc65)," >&2
    echo "            or commit with --no-verify if this is a docs change." >&2
    exit 1
fi

# THE VERSION MOVES ONLY WHEN THE PROGRAM DOES.  The stamp is the version,
# and it used to be taken from the clock on every commit - so a typo fixed in
# the README restamped identical code as a new version, and the only way
# round it was --no-verify.
#
# So the rebuild tries the version already committed first.  If the program
# and disk image come out byte-identical to the committed ones, nothing about
# the program changed and that version stands.  Only if the bytes differ is
# it rebuilt with a new stamp from the clock.  Asking the bytes rather than
# a list of "program inputs" means a Makefile edit that only adds a target,
# or a comment in a header, cannot bump the version, and a real change
# cannot fail to.
kept=""
if git rev-parse -q --verify HEAD >/dev/null &&
   git cat-file -e HEAD:build/urfinkel.prg 2>/dev/null; then
    kept=$(git show HEAD:build/urfinkel.prg | python3 -c "
import re,sys
m=re.search(rb'20\d\d\.\d\d\.\d{4}|20\d\d-\d\d-\d\d',sys.stdin.buffer.read())
sys.stdout.write(m.group().decode() if m else '')
")
fi

# The offline zip is not built here: it is a release artefact (tools/release.sh).
echo "pre-commit: clean rebuild..."
make clean >/dev/null
if [ -n "$kept" ]; then
    make      BUILD_DATE="$kept" >/dev/null
    make disk BUILD_DATE="$kept" >/dev/null
    if git show HEAD:build/urfinkel.prg | cmp -s - build/urfinkel.prg &&
       git show HEAD:build/urfinkel.d64 | cmp -s - build/urfinkel.d64; then
        echo "pre-commit: the program is unchanged - it stays version $kept"
    else
        echo "pre-commit: the program changed - new version"
        make clean >/dev/null
        kept=""
    fi
fi
if [ -z "$kept" ]; then
    make      >/dev/null
    make disk >/dev/null
fi

echo "pre-commit: host tests..."
if ! make check >/tmp/urfinkel-check.$$ 2>&1; then
    echo "pre-commit: TESTS FAILED - commit refused" >&2
    tail -30 /tmp/urfinkel-check.$$ >&2
    rm -f /tmp/urfinkel-check.$$
    exit 1
fi
rm -f /tmp/urfinkel-check.$$

# `make conform` is the other half of the gate, but it drives VICE and takes
# an emulator run to do it, which is too slow to sit in front of every
# commit.  Set URFINKEL_CONFORM=1 to include it.
if [ "${URFINKEL_CONFORM:-0}" = "1" ]; then
    echo "pre-commit: conformance..."
    if ! make conform >/tmp/urfinkel-conform.$$ 2>&1; then
        echo "pre-commit: CONFORMANCE FAILED - commit refused" >&2
        tail -20 /tmp/urfinkel-conform.$$ >&2
        rm -f /tmp/urfinkel-conform.$$
        exit 1
    fi
    rm -f /tmp/urfinkel-conform.$$
fi

# The README and the play page both quote the size and the hashes of what is
# published, so a rebuild that changed them has just made both wrong.
# Regenerating here keeps the claim and the file it describes in the same
# commit, which is the only arrangement in which the claim is worth anything.
#
# BOTH FILES ARE HANDLED, not just the README.  checksums.sh has written the
# play page since the download buttons were generated, and this hook staged
# only the README - so a commit that changed the page could leave the page
# itself behind: the archives would be built from the new one, their hashes
# committed, and the page holding those hashes left unstaged.  pre-push
# caught it, correctly and confusingly, as "a sidecar differs from HEAD".
#
# Whether either may be staged is decided BEFORE the script runs. If a file
# already had unstaged edits, they are someone's work in progress - a
# `git add -p` session, most likely - and staging it wholesale would sweep all
# of it into this commit. In that case the edit is made on disk and left
# unstaged, with a notice; pre-push is the gate that stops a stale one from
# ever reaching the remote.
GENERATED="README.md docs/index.html INSTALL.md"

clean_before=""
for f in $GENERATED; do
    git diff --quiet -- "$f" && clean_before="$clean_before $f"
done

echo "pre-commit: checksums..."
tools/checksums.sh

git add build/urfinkel.prg build/urfinkel.d64
git add build/urfinkel.prg.sha256 build/urfinkel.prg.md5
git add build/urfinkel.d64.sha256 build/urfinkel.d64.md5
git add build/CHECKSUMS.txt

for f in $GENERATED; do
    case " $clean_before " in
        *" $f "*) git add "$f" ;;
        *) git diff --quiet -- "$f" || {
               echo "pre-commit: $f had unstaged edits, so the generated block was"
               echo "            written but NOT staged. Stage it yourself if it"
               echo "            belongs in this commit."
           } ;;
    esac
done

if git diff --cached --quiet -- build/urfinkel.prg build/urfinkel.d64; then
    echo "pre-commit: binaries unchanged"
else
    echo "pre-commit: binaries rebuilt and staged"
fi

exit 0
